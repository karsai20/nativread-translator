{
  "name": "nativread-translator",
  "version": "0.1.0",
  "private": true,
  "description": "NativRead translator backend: web/API book translator (EN->HU). Serves the NativRead iOS app; reusable translation core.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "cf:typecheck": "tsc --noEmit -p cloudflare/tsconfig.json",
    "cf:dev": "wrangler dev --config cloudflare/wrangler.jsonc",
    "cf:migrate:local": "wrangler d1 migrations apply nativread-production --local --config cloudflare/wrangler.jsonc",
    "cf:dry-run": "wrangler deploy --dry-run --containers-rollout=none --config cloudflare/wrangler.jsonc",
    "cf:deploy": "wrangler deploy --config cloudflare/wrangler.jsonc"
  },
  "dependencies": {
    "@cloudflare/containers": "^0.3.7",
    "@radix-ui/react-alert-dialog": "^1.1.17",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-dropdown-menu": "^2.1.18",
    "@radix-ui/react-slider": "^1.4.1",
    "@radix-ui/react-slot": "^1.3.0",
    "@radix-ui/react-tooltip": "^1.2.10",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.12",
    "fast-xml-parser": "^5.10.1",
    "fflate": "^0.8.2",
    "jose": "^6.2.4",
    "lucide-react": "^0.460.0",
    "next": "^15.5.21",
    "node-html-parser": "^6.1.13",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260722.1",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/bun": "^1.2.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.18",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^4.113.0"
  },
  "overrides": {
    "postcss": "^8.5.18",
    "sharp": "^0.35.3"
  }
}
