# Provider API key (DeepSeek). Leave empty to use the zero-cost fake provider.
PROVIDER_API_KEY=

# Network binding. Inside a container bind 0.0.0.0 so the host can reach it.
HOST=0.0.0.0
# Uncommon, non-well-known port so it does not collide with common services.
PORT=48217

# Where per-job state (resume) is persisted. Point at a mounted volume in a container.
JOBS_DIR=./jobs

# Hard per-book cost ceiling in USD (translation aborts before exceeding it).
COST_CEILING_USD=10
