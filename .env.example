# Shared household provider API key (DeepSeek). Empty = zero-cost fake provider.
PROVIDER_API_KEY=

# Persistent storage (point at Proxmox volumes in the container).
JOBS_DIR=jobs
LIBRARY_DIR=library

# Hard per-book cost ceiling in USD (translation aborts before exceeding it).
COST_CEILING_USD=10

# Second "polish" pass for higher translation quality (1 = on, 0 = off). ~2x cost/time.
TRANSLATION_REFINE=1

# Port the app listens on (uncommon, non-well-known). Used by `next start -p`.
PORT=48217
