# Provider selection. fake = zero-cost dry run.
# TRANSLATION_PROVIDER: fake | openai | gemini | deepseek
TRANSLATION_PROVIDER=fake
PROVIDER_API_KEY=
PROVIDER_MODEL=

# Optional provider-specific overrides.
# Recommended paid MVP setup:
# TRANSLATION_PROVIDER=gemini
# PROVIDER_API_KEY=...
# PROVIDER_MODEL=gemini-2.5-flash
# Use a billing-enabled paid Gemini API project for the public iOS client.
# OPENAI_API_KEY=
# OPENAI_MODEL=
# GEMINI_API_KEY=
# GEMINI_MODEL=
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=
# PROVIDER_BASE_URL=
# Model the hardest chunks escalate to for their polish pass. WITHOUT THIS the escalation
# silently runs on the normal model, i.e. it does nothing. Pick the tier above PROVIDER_MODEL.
# PROVIDER_REASONER_MODEL=gemini-3.6-flash
# Thinking level for the draft/refine/judge calls. Gemini thinks by default and bills
# thought tokens at the OUTPUT rate — measured on gemini-3.6-flash, one sentence cost 731
# thinking tokens against 16 tokens of answer. Defaults to "minimal"; hard chunks still
# escalate to PROVIDER_REASONER_MODEL, which keeps its thinking. Use "low"/"medium"/"high"
# to buy it back, or "default" to send nothing and let the provider decide.
# PROVIDER_THINKING=minimal

# Persistent storage (point at Proxmox volumes in the container).
JOBS_DIR=jobs
LIBRARY_DIR=library

# Hard per-book cost ceiling in USD (translation aborts before exceeding it).
COST_CEILING_USD=10
MAX_EPUB_UPLOAD_BYTES=33554432
MAX_EPUB_ENTRIES=2000
MAX_EPUB_UNCOMPRESSED_BYTES=134217728

# Second "polish" pass for higher translation quality (1 = on, 0 = off). ~2x cost/time.
TRANSLATION_REFINE=1

# Port the app listens on (uncommon, non-well-known). Used by `next start -p`.
PORT=48217

# Unauthenticated dev / LAN mode (client-supplied x-nativread-user-id header,
# no login and no shared secret). Allowed by default outside production; a
# production build serves those requests only with ALLOW_DEV_AUTH=1.
# ALLOW_DEV_AUTH=0

# Public iOS authentication and compliant account deletion.
APPLE_CLIENT_IDS=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Paste the .p8 key as one value and encode line breaks as `\n`.
APPLE_PRIVATE_KEY=
NATIVREAD_SESSION_SECRET=
