# NativRead dedicated translator backend.
#
# Copy to .env.nativread, set PROVIDER_API_KEY, then run:
#   bash scripts/setup-nativread-backend.sh

APP_PROFILE=nativread
NATIVREAD_TRANSLATOR_PORT=48218

TRANSLATION_PROVIDER=gemini
PROVIDER_API_KEY=
PROVIDER_MODEL=gemini-2.5-flash
# Production iOS distribution in the EEA requires a billing-enabled paid
# Gemini API project; do not expose Gemini's unpaid service tier to users.
PROVIDER_BASE_URL=
PROVIDER_REASONER_MODEL=

COST_CEILING_USD=10
TRANSLATION_REFINE=1
TRANSLATION_REFINE_SELECTIVE=1
TRANSLATION_REASONER_HARD=1
TRANSLATION_PRECISION=balanced
TRANSLATION_CONCURRENCY=4
MAX_EPUB_UPLOAD_BYTES=33554432
MAX_EPUB_ENTRIES=2000
MAX_EPUB_UNCOMPRESSED_BYTES=134217728

# Production hardening for an externally reachable backend:
# - Set NATIVREAD_BACKEND_SHARED_SECRET and configure the mobile client to send it.
# - For a trusted-LAN $0 purchase test only, set both entitlement enforcement and
#   unsigned grants to 1. Never expose unsigned grants to the internet.
# - In production keep entitlement enforcement at 1, unsigned grants at 0, and
#   replace the placeholder route with signed StoreKit transaction verification.
NATIVREAD_BACKEND_SHARED_SECRET=
REQUIRE_TRANSLATION_ENTITLEMENTS=0
STOREKIT_ALLOW_UNSIGNED_GRANTS=0

# With no login AND no shared secret, requests would be served against a
# caller-supplied user-id header. A production build refuses that path unless it
# is opted into here — set it only for a trusted, non-routable LAN deployment.
ALLOW_DEV_AUTH=0

# Public login: once EITHER client-id list is set, every request must carry either
# a valid provider id-token or a NativRead session minted from it. The userId is
# derived from the verified token; the header/shared-secret path is then ignored.
# Generate NATIVREAD_SESSION_SECRET from at least 32 cryptographically random bytes.
# Leave both client-id lists empty for the LAN/dev flow (shared secret + header).
# Comma-separated to allow multiple bundle/service or client ids.
#   APPLE_CLIENT_IDS  = Sign in with Apple audience(s): the app bundle id (and any services id)
#   GOOGLE_CLIENT_IDS = Google OAuth client id(s) that mint the id-token (…apps.googleusercontent.com)
APPLE_CLIENT_IDS=
GOOGLE_CLIENT_IDS=
NATIVREAD_SESSION_SECRET=

# Required for compliant Sign in with Apple revocation during account
# deletion. APPLE_PRIVATE_KEY accepts the .p8 content with escaped `\n`.
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Source EPUBs and generated results are deleted immediately after a successful
# consumed download. This TTL removes abandoned jobs and unclaimed results.
# Public mode enforces a 30-day maximum even if a larger value is configured.
ARTIFACT_RETENTION_HOURS=24
