[Unit]
Description=nativread-web (web book translator, EN->HU)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Next.js standalone server. WorkingDirectory must be the standalone root so it finds
# .next/static alongside server.js.
WorkingDirectory=/opt/nativread-web/.next/standalone
ExecStart=/usr/bin/node server.js
EnvironmentFile=/opt/nativread-web/.env
Environment=NODE_ENV=production
Environment=HOSTNAME=0.0.0.0
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
